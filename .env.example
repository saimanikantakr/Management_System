# ===================================================================
# Employee & Department Management System - Environment Variables
# Copy this file to .env or set environment variables in your deployment
# ===================================================================

# Database Connection URL (MySQL)
DB_URL=jdbc:mysql://localhost:3306/employee_management?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database Credentials
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Application Server Port
SERVER_PORT=8080

